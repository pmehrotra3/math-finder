# Copy to .env and edit. Every setting is optional.

# Which LLM backend to use:
#   cli  (default) the `claude` command-line tool, using your Claude subscription
#   api            the Anthropic API (needs ANTHROPIC_API_KEY)
MATHFINDER_LLM=cli

# Model for the cli backend (default: whatever `claude` uses)
# MATHFINDER_CLI_MODEL=

# Needed only for MATHFINDER_LLM=api
# ANTHROPIC_API_KEY=

# Lean checking: number of Lean REPL processes (each loads Mathlib, ~8 GB resident, partly shared)
# MATHFINDER_LEAN_WORKERS=2
# Restart a REPL after this many checks (its memory grows with every check)
# MATHFINDER_LEAN_RECYCLE=300
